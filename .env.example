# === Copia este archivo a .env y ajusta los valores ===
# .env NO se sube a git (está en .gitignore).

# ---- Ambiente ----
# Valores: development | staging | production
ENVIRONMENT=development

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=calculo3
MYSQL_USER=calculo3
MYSQL_PASSWORD=change_me_user
MYSQL_PORT=3307

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
# IP donde Docker publica el puerto del backend. Vacío/0.0.0.0 = público
# (default). Usa 127.0.0.1 solo si un reverse proxy (nginx) en el mismo
# VPS va a ser el único punto de entrada público — ver DEPLOYMENT.md Fase 5.
BACKEND_BIND=0.0.0.0
# Cadena de conexión SQLAlchemy. En Docker el host es "mysql" (nombre del servicio).
DATABASE_URL=mysql+pymysql://calculo3:change_me_user@mysql:3306/calculo3

# Secreto para firmar JWT — genera uno fuerte con: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440
JWT_REFRESH_TOKEN_DAYS=7

# Orígenes permitidos por CORS. Solo se usa fuera de development (en
# development el backend ya permite localhost:3000 fijo). Coma-separado,
# sin barra final al final de cada URL.
# Ej: ALLOWED_ORIGINS=http://203.0.113.10:3000,https://calculo3.tudominio.mx
ALLOWED_ORIGINS=

# Zona horaria del sistema (todos los cálculos temporales)
TZ=America/Mexico_City

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# Mismo criterio que BACKEND_BIND (ver arriba).
FRONTEND_BIND=0.0.0.0
# URL pública del backend vista desde el navegador del alumno
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL interna del backend vista desde el contenedor de Next.js (SSR).
# Usa el nombre del servicio de compose, no localhost.
INTERNAL_API_URL=http://backend:8000

# ---- Notion (opcional, no requerido para MVP) ----
NOTION_API_TOKEN=
NOTION_ROOT_PAGE_ID=

# ---- Email (opcional, no requerido para MVP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
